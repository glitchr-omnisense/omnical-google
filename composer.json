{
    "name": "omnical/google",
    "type": "library",
    "description": "Omnical's Google Calendar, under any PHP host: a user's calendars, their events read and written (time zones, all-day events, recurrence kept as RRULE lines, attendees and their answers, ETags against lost updates) and busy time, through the Calendar API v3 over OAuth 2.0 - the token refreshed once on a 401, Google's quotas declared as data and enforced per project and per user.",
    "keywords": ["google-calendar", "calendar", "events", "free-busy", "oauth2", "rrule", "framework-agnostic", "omnical"],
    "homepage": "https://github.com/glitchr-omnisense/omnical-google",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0@dev",
        "omnisense/omnical": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnical\\Google\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnical\\Google\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnisense": {
            "policy": "policy.json"
        },
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
